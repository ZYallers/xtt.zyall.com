# 照片/视频原图不入库（体积原因，本地另行备份；部署用对象存储或服务器同步）
resources/
resources2/

# ---- .workbuddy：构建脚本入库，敏感与体积大的部分排除 ----
# 注：~/.gitignore_global 里也有一条 .workbuddy，会挡住整个目录，
#     所以这里先显式反忽略，再逐项排除（规则按书写顺序后匹配者生效）
!.workbuddy/
!.workbuddy/**
# content.key 与 data.json（明文清单）绝不能公开
.workbuddy/private/
# 本机会话记忆，不入库
.workbuddy/memory/
# ffmpeg 静态二进制（43MB），按 build_gallery.py 头部提示自行下载
.workbuddy/bin/

# 系统文件
.idea/
.DS_Store
*.tmp
*.log
